EXPO_PUBLIC_OPENROUTER_API_KEY=
EXPO_PUBLIC_AI_PROVIDER=openrouter
EXPO_PUBLIC_AI_MODEL=deepseek/deepseek-chat-v3

# Google Sign-In (optional — the app works fine with email/password without
# these). To enable:
# 1. Firebase Console → Authentication → Sign-in method → enable Google
# 2. Firebase auto-creates a Web OAuth client — copy its Client ID below
# 3. For native iOS/Android builds, create matching OAuth clients in
#    Google Cloud Console (console.cloud.google.com → APIs & Services →
#    Credentials) under the same project, and paste those too.
# Without these set, the Google button will show a clear "not configured"
# message instead of failing silently.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
